# Domain setup (Replace with your actual domain, e.g., shop.yourdomain.com)
DOMAIN=shop.example.com

# Database settings (Use strong passwords in production!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=tg_shop
POSTGRES_PORT=5432

# Security (Generate a random string for JWT_SECRET)
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# YooKassa (Use production credentials)
YUKASSA_SHOP_ID=your_yookassa_shop_id
YUKASSA_SECRET_KEY=your_yookassa_secret_key
YUKASSA_RETURN_URL=https://shop.example.com/payment/return
